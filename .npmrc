# Every install in this repo resolves the whole tree from the live registry,
# because package-lock.json is gitignored (.gitignore:3). That makes a plain
# `npm install` a function of registry state on the day it runs, and on
# 2026-09-05 the state changed under us with zero commits here: vitest moved
# its `latest` dist-tag from 4.1.11 to 5.0.0, and npm's resolver started
# crashing while walking vitest 4's optional peer graph:
#
#   npm error Cannot read properties of null (reading 'edgesOut')
#       at #loadPeerSet (@npmcli/arborist/lib/arborist/build-ideal-tree.js)
#
# The chain is vitest 4.1.11 -> (optional peer) vite 8 -> @vitejs/devtools ->
# @vitejs/devtools-vitest, which declares a peer of `vitest@*`. That wildcard
# follows `latest`, so it now pulls a nested vitest 5.0.0 with no parent and
# npm dereferences null. Pinning vitest 4.1.11 does not help; the wildcard
# still chases the tag. It took every Cloudflare Pages build red at the
# install step, before the build command ran.
#
# legacy-peer-deps skips the automatic peer walk entirely. It is safe here:
# every peer this app actually needs (react, react-dom, vite, ...) is already
# a direct dependency, so nothing goes missing — verified by a clean
# `npm run build` and the full suite passing under it.
#
# This is the unblock, not the fix. The fix is either committing the lock
# file so installs stop floating, or moving to vitest 5 (which resolves
# cleanly, but needs Node 22 everywhere).
legacy-peer-deps=true
