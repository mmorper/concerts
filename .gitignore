# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build output
dist/
build/
*.local

# Session handoff docs — ephemeral, local-only scratch (consumed at /release).
# Durable cross-session knowledge lives in the Claude auto-memory, not here.
memory/session-handoff-*.md

# Environment variables
.env
.env.local
.env.production.local
.env.development.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Video production render outputs (large binaries; the video/ workspace is local)
video/renders/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files
*.tmp
.cache/

# Build-time generated files
public/version.json
public/og-image-stats.json

# Data pipeline backup files
public/data/*.backup
public/data/*.backup.*
data/*.backup
data/*.backup.*
data/venues-to-classify.csv*

# Personal data files (keep examples in git)
data/venue-status.csv

# Claude Code - ignore personal settings, keep shared config
.claude/settings.local.json
.claude/todos/
.claude/worktrees/
.claude/scheduled-tasks/

# Bug reports and debugging artifacts
bugs/

# Inspiration and reference materials
docs/inspiration/

# Articles and blog posts
docs/articles/

# Wrangler (Cloudflare Workers)
workers/.wrangler/

# SEO reports (generated by /seo command)
seo-reports/*.json
seo-reports/*.md
# Keep baseline snapshots and README
!seo-reports/*-baseline.json
!seo-reports/README.md

# Playwright MCP scratch (screenshots, console logs)
.playwright-mcp/

# Per-suite scratch dirs for the enrich-* pipeline tests. Removed in afterEach,
# but an interrupted run leaves them behind — and CI asserts a clean tree.
test/temp-output*/

# Generated worksheet for #275 artist pinning — regenerate, never commit
artist-pins-TODO.csv

# Personal-media audit corpus (#348). Lives inside the project deliberately — the
# owner wants it within the project boundary and agent-writable — but is NEVER
# committed: it holds thousands of unculled personal photographs plus their EXIF
# (GPS, capture time, device). Only the FINAL selects reach the repo, EXIF-stripped,
# under public/images/concerts/.
# Evaluation workspace for the media audit (#348). Ignored in full — it holds personal
# photographs, downloaded originals and test verdicts, none of which may ever be committed.
#
# ONE named exception: bin/osxphotos, the read-only guard. It is the mechanism that keeps
# this project from writing to the Photos library, it is sixty lines of shell that can hold
# no personal data, and it needs to be reviewable and testable. The binary it wraps
# (.osxphotos-raw) stays ignored. See concert-photos-audit/README.md.
concert-photos-audit/*
!concert-photos-audit/bin/
concert-photos-audit/bin/*
!concert-photos-audit/bin/osxphotos
!concert-photos-audit/bin/BUILD.txt
osxphotos_crash.log
