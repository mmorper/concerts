{
  "name": "morperhaus-ask-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Morperhaus Concert Archive — in-app 'Ask the Archive' chat backend (tool-grounded agent loop). Sibling worker to morperhaus-mcp; reuses its pure tool fns + data layer.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "deploy": "npx wrangler deploy",
    "dev": "npx wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tail": "npx wrangler tail"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.2",
    "typescript": "^5.7.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.140.0"
  }
}
