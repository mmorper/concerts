{
  "name": "morperhaus-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Morperhaus Concert Archive MCP server — Cloudflare Worker exposing 40 years of concert history as a Model Context Protocol server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "deploy": "npx wrangler deploy",
    "dev": "npx wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tail": "npx wrangler tail"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "^0.23.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
