{
  "name": "morperhaus-concerts",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive concert history timeline application",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/generate-version.ts && tsc && tsx scripts/gen-mcp-landing.ts && vite build",
    "preview": "vite preview",
    "build-data": "tsx scripts/build-data.ts",
    "fetch-sheet": "tsx scripts/fetch-google-sheet.ts",
    "enrich": "tsx scripts/enrich-artists.ts",
    "enrich:discography": "tsx scripts/enrich-discography.ts",
    "derive:album-eras": "tsx scripts/derive-album-eras.ts",
    "resolve:song-albums": "tsx scripts/resolve-song-albums.ts",
    "enrich:tracks": "tsx scripts/enrich-top-tracks.ts",
    "enrich-spotify": "tsx scripts/enrich-spotify-metadata.ts",
    "generate-mock-spotify": "tsx scripts/generate-mock-spotify-metadata.ts",
    "geocode": "tsx scripts/geocode-venues.ts",
    "export-venues": "tsx scripts/export-venues.ts",
    "enrich-venues": "tsx scripts/enrich-venues.ts",
    "test-places-api": "tsx scripts/test-places-api.ts",
    "review-venue-photos": "tsx scripts/review-venue-photos.ts",
    "deduplicate-artists": "tsx scripts/deduplicate-artists.ts",
    "validate-normalization": "tsx scripts/validate-normalization.ts",
    "validate-data": "tsx scripts/validate-concerts.ts",
    "validate:artist-genres": "tsx scripts/validate-artist-genres.ts",
    "validate:version": "tsx scripts/validate-version-sync.ts",
    "validate:docs": "tsx scripts/validate-docs.ts",
    "diff-data": "tsx scripts/diff-concerts.ts",
    "aggregate:genres": "tsx scripts/aggregate-genres-timeline.ts",
    "generate-artist-metadata": "tsx scripts/generate-artist-metadata.ts",
    "prefetch:setlists": "tsx scripts/prefetch-setlists.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:pipeline": "vitest run test/pipeline",
    "test:scenes": "vitest run test/scenes",
    "test:utils": "vitest run test/utils",
    "test:smoke": "node test/scenes/test-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test:workers": "npm --prefix workers/mcp-server test && npm --prefix workers/ask-chat test",
    "test:everything": "npm run test:run && npm run test:workers",
    "test:all": "tsx scripts/run-tests.ts",
    "test:all:quick": "tsx scripts/run-tests.ts --quick",
    "test:all:coverage": "tsx scripts/run-tests.ts --coverage",
    "test:scenes:puppeteer": "node scripts/run-scene-tests.mjs",
    "test:timeline": "node test/scenes/test-timeline.mjs",
    "test:venues": "node test/scenes/test-venues.mjs",
    "test:map": "node test/scenes/test-map.mjs",
    "test:genres": "node test/scenes/test-genres.mjs",
    "test:artists": "node test/scenes/test-artists.mjs",
    "update:meta": "tsx scripts/update-meta-tags.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "og:generate": "tsx scripts/generate-og-simple.ts",
    "og:preview": "tsx scripts/preview-og-crops.ts",
    "generate:brand": "tsx scripts/generate-brand-assets.ts",
    "cleanup:backups": "tsx scripts/cleanup-backups.ts",
    "seo": "tsx scripts/analyze-seo.ts",
    "generate:facts": "tsx scripts/generate-facts.ts",
    "generate:most-played-songs": "tsx scripts/aggregate-most-played-songs.ts",
    "generate:rss": "tsx scripts/generate-rss.ts",
    "generate:liner-notes-rss": "tsx scripts/generate-liner-notes-rss.ts",
    "generate:liner-notes": "tsx scripts/liner-notes/index.ts",
    "syndicate": "tsx scripts/syndication/index.ts",
    "harvest:handles": "tsx scripts/syndication/harvest-handles.ts",
    "contact-sheet": "tsx scripts/syndication/contact-sheet.ts",
    "backfill:social": "tsx scripts/backfill-social.ts",
    "generate:on-this-day": "tsx scripts/on-this-day/index.ts",
    "refresh:liner-note-images": "tsx scripts/refresh-liner-note-images.ts",
    "generate:narrations": "tsx scripts/generate-narrations.ts",
    "deploy:worker": "cd workers/meta-injector && npx wrangler deploy",
    "deploy:mcp-server": "cd workers/mcp-server && npx wrangler deploy",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:scripts",
    "sync:aliases": "tsx scripts/sync-artist-aliases.ts",
    "media": "node --disable-warning=DEP0205 node_modules/.bin/tsx scripts/media/index.ts",
    "media:prep": "node --disable-warning=DEP0205 node_modules/.bin/tsx scripts/media/prep.ts",
    "media:audit": "node --disable-warning=DEP0205 node_modules/.bin/tsx scripts/media/audit.ts",
    "media:ingest": "node --disable-warning=DEP0205 node_modules/.bin/tsx scripts/media/ingest.ts",
    "media:review": "node --disable-warning=DEP0205 node_modules/.bin/tsx scripts/media/review.ts",
    "media:crop": "node --disable-warning=DEP0205 node_modules/.bin/tsx scripts/media/crop.ts",
    "media:frames": "node --disable-warning=DEP0205 node_modules/.bin/tsx scripts/media/frames.ts",
    "render:card": "tsx scripts/syndication/render-card.ts",
    "syndicate:preview": "node --disable-warning=DEP0205 node_modules/.bin/tsx scripts/syndication/preview.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@types/d3": "^7.4.3",
    "csv-parse": "^6.1.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^11.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.39.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^2.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.11.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "googleapis": "^144.0.0",
    "open": "^11.0.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "puppeteer": "^24.34.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.0"
  }
}
