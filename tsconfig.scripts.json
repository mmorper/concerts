{
  // Typechecks everything the root tsconfig doesn't (#246).
  //
  // `tsconfig.json` has `"include": ["src"]`, so `npm run typecheck` covered the
  // React app and nothing else — not the liner-notes pipeline, not the data
  // pipeline, not the tests. Code with an undefined variable in it passed clean;
  // the failure only appeared when the pipeline was run by hand.
  //
  // A separate config rather than widening `include`, because these run under
  // `tsx` (Node globals, ES2022) while the app is built by Vite for the browser.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Node built-ins for the scripts; vite/client so `import.meta.env` still
    // resolves in the `src/` modules the tests and scripts import.
    "types": ["node", "vite/client"],

    // On. These started off while the ~70 pre-existing findings were cleared;
    // they stay on so the cruft can't come back.
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // scripts/archive is included deliberately. Excluding it is what hid the fact
  // that convert-csv-to-json.ts — a documented fallback for the Google Sheets
  // pipeline — had been moved without its relative imports being fixed, so it
  // crashed on startup.
  "include": ["scripts", "test"]
}
