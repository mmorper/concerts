# Now Spinning listener (Phase 4a, #696). Installed to /etc/systemd/system/ by install.sh.
# Spec: global-now-spinning-spec.md §Pi listener, "A shared Pi": its own user, a sandbox, code it
# can't change, and a home that holds data only.

[Unit]
Description=Now Spinning listener (receiver control, display wake, health)
Wants=network-online.target
After=network-online.target sound.target

[Service]
Type=simple
User=now-spinning
Group=now-spinning
SupplementaryGroups=audio
EnvironmentFile=/etc/now-spinning/env
Environment=HOME=/var/lib/now-spinning PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/now-spinning/app
ExecStart=/opt/now-spinning/venv/bin/python -m now_spinning
Restart=on-failure
RestartSec=10

# Sandbox. The service can write only to its own home (the Apple TV pairing lives there).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
StateDirectory=now-spinning
StateDirectoryMode=0700
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# No privileges at all, and only the network kinds it uses: IPv4/6 (receiver, Apple TV, Worker,
# Wake-on-LAN), Unix sockets (ALSA) and netlink (finding the network interfaces).
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
ProtectProc=invisible
ProtectKernelLogs=yes
ProtectHostname=yes
SystemCallArchitectures=native
# Not set, on purpose: PrivateDevices and ProtectClock (both cut off /dev/snd, the Blackjack) and
# ProcSubset=pid (ALSA reads /proc/asound).

[Install]
WantedBy=multi-user.target
