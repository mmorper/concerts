# /etc/now-spinning/env — root-only (chmod 600). systemd reads it before starting the service.
# install.sh copies this template there the first time; fill in the token, then keep it private.
# Addresses are this house's, from Phase 0 (#688). The two device identifiers are left blank on
# purpose (this repo is public); NOW_SPINNING_OPERATIONS.md §12 says how to read them on the Pi.

NS_WORKER_URL=https://concerts.morperhaus.org
# The ingest token, from 1Password ("Now Spinning ingest token"). Never commit it.
NS_INGEST_TOKEN=

NS_RECEIVER_HOST=192.168.1.240
# The Apple TV's identifier, from: atvremote --scan-hosts 192.168.1.111 scan (as now-spinning)
NS_APPLE_TV_ID=
NS_APPLE_TV_HOST=192.168.1.111
# The TV's MAC address, from: ip neigh show 192.168.1.231 (with the TV on)
NS_TV_MAC=
NS_WOL_BROADCAST=192.168.1.255
NS_AUDIO_DEVICE=Blackjack
# Brought forward when a record starts. Music until the Now Spinning tvOS app is installed (#701);
# then its bundle ID goes here.
NS_APP_BUNDLE_ID=com.apple.TVMusic
# Song recognition: shazam (the default), or off (the listener still controls the receiver and
# wakes the display, but names no songs). A paid recogniser would be a third value.
NS_RECOGNIZER=shazam
