// Copy to Secrets.xcconfig (gitignored) and fill in. Never commit the real file.
//
// The display token: the same value as the Worker's NOW_SPINNING_DISPLAY_TOKEN secret (docs/SECRETS.md).
// Hex only, as `openssl rand -hex 32` makes it.
NOW_SPINNING_DISPLAY_TOKEN = paste-the-display-token-here

// Your Apple Developer team ID (Xcode → Settings → Accounts, or developer.apple.com → Membership).
DEVELOPMENT_TEAM = YOURTEAMID
